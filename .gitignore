# Melos
.melos_tool/
pubspec.lock
!sancta_via_*/pubspec.lock

# Build artifacts
build/
.dart_tool/
out/

# IDE
.idea/
.vscode/
*.iml

# Node
node_modules/
package-lock.json

# System
.DS_Store

# Local overrides
local.properties
releases/
