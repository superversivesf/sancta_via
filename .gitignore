# Release signing secrets (defense in depth: per-app android/.gitignore already
# covers these inside each app; these rules catch stray copies elsewhere)
**/key.properties
**/keystores/
*.jks
*.keystore

# Signing profiles + fastlane reports (credential-shaped artifacts)
*.mobileprovision
*.p12
fastlane/report.xml
