{
  "name": "sancta-via-liturgical-calendar-generator",
  "version": "2.0.0",
  "description": "Generates liturgical calendar data for Sancta Via monorepo using RomCal",
  "main": "generate-calendar.js",
  "scripts": {
    "test": "node test-romcal.js",
    "generate": "node generate-calendar.js",
    "generate-dart": "node generate-dart-calendar.js",
    "generate-10-years": "node generate-calendar.js --years=10",
    "generate-dart-10-years": "node generate-dart-calendar.js --years=10",
    "generate-range": "node generate-calendar.js --start=2024 --end=2035",
    "generate-dart-range": "node generate-dart-calendar.js --start=2024 --end=2035",
    "clean": "rm -rf ../../legacy/assets/liturgical/*.json",
    "clean-dart": "rm -rf ../../packages/liturgical_calendar/lib/src/data/generated/*.dart",
    "install-and-generate": "npm install && npm run generate",
    "install-and-generate-dart": "npm install && npm run generate-dart"
  },
  "dependencies": {
    "romcal": "^1.3.0"
  },
  "keywords": ["liturgical", "calendar", "catholic", "romcal", "monorepo"],
  "author": "Sancta Via",
  "private": true
}