# Sancta Via release automation — fill in .env, see fastlane/README.md.
opt_out_usage

APP_NAMES = %w[
  bible_reading_app
  confession_companion
  devotionals
  liturgical_calendar_app
  novena_companion
  prayer_companion
  saint_companion
].freeze

# fastlane chdirs into ./fastlane/ for every lane (FastlaneFolder.path), so all
# repo-relative paths must be built from this file's location, never from cwd.
REPO_ROOT = File.expand_path('..', __dir__)

# The seven store identifiers, one per app (bundle ID standardisation, 2026-11-17).
def package_name(app)
  "net.superversive.sancta_via.#{app}"
end

# Lanes accept `fastlane ship_ios app:saint_companion` (options hash) and fall
# back to APP_NAME=<app> in the environment.
def app_from(options)
  app = options[:app] || ENV['APP_NAME']
  UI.user_error!("Set the app: `fastlane ship_ios app:saint_companion` (one of #{APP_NAMES.join(', ')})") if app.nil?
  UI.user_error!("Unknown app '#{app}'. Valid: #{APP_NAMES.join(', ')}") unless APP_NAMES.include?(app)
  app
end

def asc_api_key
  UI.user_error!('ASC API key env vars missing — see fastlane/README.md') unless
    ENV['ASC_KEY_ID'] && ENV['ASC_ISSUER_ID'] && ENV['ASC_KEY_PATH']

  app_store_connect_api_key(
    key_id: ENV['ASC_KEY_ID'],
    issuer_id: ENV['ASC_ISSUER_ID'],
    key_filepath: ENV['ASC_KEY_PATH'],
    duration: 1200,
    in_house: false
  )
end

def build_and_testflight(options)
  app = app_from(options)
  app_dir = File.join(REPO_ROOT, "sancta_via_#{app}")
  UI.user_error!("App dir not found: #{app_dir}") unless Dir.exist?(app_dir)

  build_app(
    project: File.join(app_dir, 'ios', 'Runner.xcodeproj'),
    scheme: 'Runner',
    configuration: 'Release',
    export_method: 'app-store',
    export_options: {
      signingStyle: 'automatic',
      provisioningProfiles: {}
    }
  )
  upload_to_testflight(
    api_key: asc_api_key,
    skip_waiting_for_build_processing: true,
    distribute_external: false,
    changelog: ENV['RELEASE_NOTES'] || 'Routine refresh of prayers and data.'
  )
end

def build_and_play(options)
  app = app_from(options)
  app_dir = File.join(REPO_ROOT, "sancta_via_#{app}")
  UI.user_error!("App dir not found: #{app_dir}") unless Dir.exist?(app_dir)
  UI.user_error!('Play service-account env var missing — see fastlane/README.md') unless
    ENV['PLAY_JSON_KEY_PATH']

  aab = File.join(app_dir, 'android', 'app', 'build', 'outputs', 'bundle', 'release', 'app-release.aab')
  UI.user_error!("No release AAB at #{aab} — build it first (flutter build appbundle in #{app_dir})") unless File.exist?(aab)

  # Store listing text/screenshots are entered by hand in the Play Console for
  # first submission; the fastlane metadata trees are reserved for F-Droid.
  upload_to_play_store(
    package_name: package_name(app),
    json_key: ENV['PLAY_JSON_KEY_PATH'],
    track: 'internal',
    aab: aab,
    release_status: 'draft',
    skip_upload_metadata: true,
    skip_upload_changelogs: true,
    skip_upload_images: true,
    skip_upload_screenshots: true
  )
end

# The seven store display names for App Store Connect record creation
# (ASC names can be edited later; bundle IDs are permanent).
APP_META = {
  'bible_reading_app' => 'Sancta Via Bible',
  'confession_companion' => 'Sancta Via Examen',
  'devotionals' => 'Sancta Via Devotionals',
  'liturgical_calendar_app' => 'Sancta Via Calendar',
  'novena_companion' => 'Sancta Via Novena',
  'prayer_companion' => 'Sancta Via Prayer',
  'saint_companion' => 'Sancta Via Saints',
}.freeze

lane :install_profiles do
  api_key = asc_api_key
  APP_NAMES.each do |app|
    UI.important("Ensuring App Store profile for #{app}")
    sigh(
      api_key: api_key,
      app_identifier: package_name(app),
      provisioning_name: "#{APP_META[app]} App Store",
      skip_certificate_verification: false
    )
  end
end

lane :register_apps do
  APP_NAMES.each do |app|
    UI.important("Registering #{app} (#{package_name(app)}) as '#{APP_META[app]}'")
    produce(
      app_identifier: package_name(app),
      app_name: APP_META[app],
      sku: package_name(app),
      team_id: 'U2267GC4DS',
      company_name: 'Superversive',
      api_key_path: ENV['ASC_KEY_PATH'],
      skip_itc: false
    )
  end
end

lane :asc_key_check do
  UI.message('Checking App Store Connect API key…')
  api_key = asc_api_key
  UI.success("API key OK (token obtained for team #{api_key[:team_id]})")
end

lane :ship_ios do |options|
  build_and_testflight(options)
end

lane :ship_android do |options|
  build_and_play(options)
end

lane :ship_all do
  # All seven apps, iOS only: TestFlight builds in one command. Android
  # ships per app (first publish per listing happens in the Console).
  APP_NAMES.each do |app|
    UI.important("Shipping iOS: #{app}")
    build_and_testflight({ app: app })
  end
end
