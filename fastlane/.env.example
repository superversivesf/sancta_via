# Copy to .env (never committed) and fill in — see fastlane/README.md.

# Apple App Store Connect API key (TestFlight uploads).
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=

# Optional release notes for TestFlight; otherwise a default is used.
# RELEASE_NOTES=

# Google Play service-account JSON (Play internal-track uploads).
PLAY_JSON_KEY_PATH=
